{
  "SDKVersion": 2,
  "Name": "RocRail Client",
  "Author": "Achim Marikar",
  "Version": "1.0.0",
  "Description": "Plugin for OpenDeck that connects to RocRail and enables to control your model train via stream deck",
  "Icon": "icon",
  "Category": "Rocrail",
  "CategoryIcon": "icon",
  "PropertyInspectorPath": "pi/index.html",
  "CodePath": "index.js",
  "Nodejs": {
    "Version": "20"
  },
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    { "Platform": "mac", "MinimumVersion": "13" },
    { "Platform": "windows", "MinimumVersion": "10" },
    { "Platform": "linux", "MinimumVersion": "0" }
  ],
  "UUID": "com.marikar.rocrailcontrol",
  "Actions": [
    {
      "Name": "Rocrail OLED Button",
      "UUID": "com.marikar.rocrailcontrol.oled",
      "Tooltip": "OLED button for loco list, functions, or speed display",
      "Icon": "actions/oled",
      "Controllers": ["Keypad", "Encoder"],
      "States": [
        {
          "Image": "actions/oled",
          "Name": "Function off",
          "Title": "",
          "ShowTitle": true,
          "TitleAlignment": "middle",
          "FontSize": 11,
          "TitleColor": "#FFFFFFFF"
        },
        {
          "Image": "actions/oled-on",
          "Name": "Function on",
          "Title": "",
          "ShowTitle": true,
          "TitleAlignment": "middle",
          "FontSize": 11,
          "TitleColor": "#FF000000"
        }
      ]
    },
    {
      "Name": "Rocrail Accessory",
      "UUID": "com.marikar.rocrailcontrol.accessory",
      "Tooltip": "Control or watch one track-diagram element (turnout, signal, output/button, turntable; sensors/blocks/tracks status-only). Configure the item ID in the inspector.",
      "Icon": "actions/accessory",
      "Controllers": ["Keypad", "Encoder"],
      "States": [
        {
          "Image": "actions/accessory",
          "Title": "",
          "ShowTitle": true,
          "TitleAlignment": "middle",
          "FontSize": 11,
          "TitleColor": "#FFFFFFFF"
        }
      ]
    },
    {
      "Name": "Rocrail Direction Fwd",
      "UUID": "com.marikar.rocrailcontrol.dirfwd",
      "Tooltip": "Set loco direction forward",
      "Icon": "actions/dirfwd",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "actions/dirfwd"
        }
      ]
    },
    {
      "Name": "Rocrail Direction Rev",
      "UUID": "com.marikar.rocrailcontrol.dirrev",
      "Tooltip": "Set loco direction reverse",
      "Icon": "actions/dirrev",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "actions/dirrev"
        }
      ]
    },
    {
      "Name": "Rocrail Speed Dial",
      "UUID": "com.marikar.rocrailcontrol.speed",
      "Tooltip": "Dial: rotate for speed, press to stop",
      "Icon": "actions/speed",
      "Controllers": ["Encoder", "Keypad"],
      "States": [
        {
          "Image": "actions/speed"
        }
      ]
    },
    {
      "Name": "Rocrail Stop loco",
      "UUID": "com.marikar.rocrailcontrol.stoploco",
      "Tooltip": "Sets the current locomotive speed to zero (RCP velocity 0%). Requires a locomotive selected (throttle mode).",
      "Icon": "actions/stop",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "actions/stop"
        }
      ]
    },
    {
      "Name": "Rocrail Speed +5%",
      "UUID": "com.marikar.rocrailcontrol.speedplus",
      "Tooltip": "Increases the current locomotive speed by five percentage steps (RCP velocity). Requires a locomotive selected.",
      "Icon": "actions/speedplus",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "actions/speedplus"
        }
      ]
    },
    {
      "Name": "Rocrail Speed −5%",
      "UUID": "com.marikar.rocrailcontrol.speedminus",
      "Tooltip": "Decreases the current locomotive speed by five percentage steps (RCP velocity). Requires a locomotive selected.",
      "Icon": "actions/speedminus",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "actions/speedminus"
        }
      ]
    },
    {
      "Name": "Rocrail List Scroll Dial",
      "UUID": "com.marikar.rocrailcontrol.scroll",
      "Tooltip": "Encoder: scroll loco list (wrap) or function list in throttle; same step mode as global setting for OLED/speed dial",
      "Icon": "actions/scroll",
      "Controllers": ["Encoder"],
      "States": [
        {
          "Image": "actions/scroll",
          "Title": "Locos",
          "ShowTitle": true,
          "TitleAlignment": "middle",
          "FontSize": 12
        }
      ]
    },
    {
      "Name": "Rocrail Back",
      "UUID": "com.marikar.rocrailcontrol.back",
      "Tooltip": "Return to loco list (stops current loco)",
      "Icon": "actions/back",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "actions/back"
        }
      ]
    },
    {
      "Name": "Rocrail Scroll Up",
      "UUID": "com.marikar.rocrailcontrol.scrollup",
      "Tooltip": "Scroll up through loco or function list",
      "Icon": "actions/scrollup",
      "Controllers": ["Keypad", "Encoder"],
      "States": [
        {
          "Image": "actions/scrollup"
        }
      ]
    },
    {
      "Name": "Rocrail Scroll Down",
      "UUID": "com.marikar.rocrailcontrol.scrolldown",
      "Tooltip": "Scroll down through loco or function list",
      "Icon": "actions/scrolldown",
      "Controllers": ["Keypad", "Encoder"],
      "States": [
        {
          "Image": "actions/scrolldown"
        }
      ]
    }
  ]
}
